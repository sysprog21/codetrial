{
  "kind": "function",
  "entry": "sortedArrayToBST",
  "checker": "balancedBst",
  "outputType": "binaryTree",
  "cases": [
    {
      "label": "five values",
      "input": [
        [
          -10,
          -3,
          0,
          5,
          9
        ]
      ],
      "expected": [
        0,
        -3,
        9,
        -10,
        null,
        5
      ]
    },
    {
      "label": "two values allow either root",
      "input": [
        [
          1,
          3
        ]
      ],
      "expected": [
        1,
        null,
        3
      ]
    },
    {
      "label": "single value",
      "input": [
        [
          7
        ]
      ],
      "expected": [
        7
      ]
    },
    {
      "label": "four values stay balanced",
      "input": [
        [
          -4,
          -2,
          1,
          8
        ]
      ],
      "expected": [
        -2,
        -4,
        1,
        null,
        null,
        null,
        8
      ]
    }
  ],
  "paramNames": [
    "nums"
  ],
