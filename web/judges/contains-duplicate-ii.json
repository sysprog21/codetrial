{
  "kind": "function",
  "entry": "containsNearbyDuplicate",
  "checker": "exact",
  "cases": [
    {
      "label": "duplicate within k",
      "input": [
        [
          1,
          2,
          3,
          1
        ],
        3
      ],
      "expected": true
    },
    {
      "label": "adjacent duplicate",
      "input": [
        [
          1,
          0,
          1,
          1
        ],
        1
      ],
      "expected": true
    },
    {
      "label": "duplicate beyond k",
      "input": [
        [
          1,
          2,
          3,
          1,
          2,
          3
        ],
        2
      ],
      "expected": false
    },
    {
      "label": "k zero cannot reuse index",
      "input": [
        [
          1,
          1
        ],
        0
      ],
      "expected": false
    },
    {
      "label": "negative duplicate within k",
      "input": [
        [
          -1,
          2,
          -1
        ],
        2
      ],
      "expected": true
    }
  ],
  "paramNames": [
    "nums",
    "k"
  ],
  "paramTypes": [
    "integer[]",
    "integer"
  ],
  "returnType": "boolean"
}
