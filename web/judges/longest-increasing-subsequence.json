      "input": [
        [
          0,
          1,
          0,
          3,
          2,
          3
        ]
      ],
      "expected": 4
    },
    {
      "label": "all equal",
      "input": [
        [
          7,
          7,
          7,
          7,
          7,
          7,
          7
        ]
      ],
      "expected": 1
    },
    {
      "label": "strictly decreasing",
      "input": [
        [
          5,
          4,
          3,
          2,
          1
        ]
      ],
      "expected": 1
    },
    {
      "label": "subsequence not substring",
      "input": [
        [
          4,
          10,
          4,
          3,
          8,
          9
        ]
      ],
      "expected": 3
    }
  ],
  "paramNames": [
    "nums"
  ],
