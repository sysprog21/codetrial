{
  "kind": "function",
  "entry": "longestConsecutive",
  "checker": "exact",
  "cases": [
    {
      "label": "unsorted run",
      "input": [
        [
          100,
          4,
          200,
          1,
          3,
          2
        ]
      ],
      "expected": 4
    },
    {
      "label": "duplicates in long run",
      "input": [
        [
          0,
          3,
          7,
          2,
          5,
          8,
          4,
          6,
          0,
          1
        ]
      ],
      "expected": 9
    },
    {
      "label": "duplicate should not extend",
      "input": [
        [
          1,
          0,
          1,
          2
        ]
      ],
      "expected": 3
    },
    {
      "label": "empty array",
      "input": [
        []
      ],
      "expected": 0
    },
    {
      "label": "negative run",
      "input": [
        [
          -2,
          -3,
          -1,
          5
        ]
      ],
      "expected": 3
    }
  ],
  "paramNames": [
    "nums"
  ],
  "paramTypes": [
    "integer[]"
  ],
  "returnType": "integer"
}
