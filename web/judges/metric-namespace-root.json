{
  "kind": "function",
  "entry": "sharedLeadingText",
  "checker": "exact",
  "cases": [
    {
      "label": "shared short prefix",
      "input": [
        [
          "flower",
          "flow",
          "flight"
        ]
      ],
      "expected": "fl"
    },
    {
      "label": "no common first letter",
      "input": [
        [
          "dog",
          "racecar",
          "car"
        ]
      ],
      "expected": ""
    },
    {
      "label": "single string",
      "input": [
        [
          "alone"
        ]
      ],
      "expected": "alone"
    },
    {
      "label": "empty string in list",
      "input": [
        [
          "",
          "prefix"
        ]
      ],
      "expected": ""
    },
    {
      "label": "prefix is whole shortest word",
      "input": [
        [
          "inter",
          "internet",
          "internal"
        ]
      ],
      "expected": "inter"
    },
    {
      "label": "middle string breaks prefix",
      "input": [
        [
          "flower",
          "dog",
          "flow"
        ]
      ],
      "expected": ""
    },
    {
      "label": "same substring appears later",
      "input": [
        [
          "flower",
          "reflow"
        ]
      ],
      "expected": ""
    },
    {
      "label": "later string ends first",
      "input": [
        [
          "flower",
          "flow"
        ]
      ],
      "expected": "flow"
    },
    {
      "label": "middle differs at second letter",
      "input": [
        [
          "ab",
          "axc",
          "abcd"
        ]
      ],
      "expected": "a"
    },
    {
      "label": "matching column after mismatch",
      "input": [
        [
          "abc",
          "axc"
        ]
      ],
      "expected": "a"
    }
  ],
  "paramNames": [
    "strs"
  ],
  "paramTypes": [
    "string[]"
  ],
  "returnType": "string"
}
