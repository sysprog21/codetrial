# deps
node_modules/
# package-lock.json is committed. It was excluded while the only devDependency
# was playwright, which pins playwright-core exactly, so the lockfile really did
# add nothing but a darwin-only fsevents entry. eslint changed that: 90 packages
# with 102 range-typed transitive dependencies, re-resolved on every install, so
# without the lockfile CI runs a gate nobody can reproduce.
.venv/
__pycache__/

# builds
.next/
out/
target/
tests/artifacts/
scripts/leetcode-cache/
problem-bank/leetcode/
*.tsbuildinfo
next-env.d.ts

# accounts — holds GitHub logins, live session tokens and report contents
*.db
# WAL journalling leaves these two beside the database on every run
*.db-wal
*.db-shm

# env — secrets never get committed. Broad on purpose: `.env`, `.env.local` and
# `.env*.local` left `.env.production` tracked, which is the one most likely to
# hold a real key.
.env*
!.env.example
# Every provider file holds a LiveKit secret and a Gemini key, and the name
# after the dot is the operator's to choose, so the rule has to cover all of
# them. Only the checked-in template is exempt.
config/*.env.*
!config/*.env.example

# local reference material
DONT-MERGE/

# misc
.DS_Store
*.log
.gstack/

# vendored binaries fetched by scripts/fetch-vendor.sh, pinned in
# web/vendor/face-detection/SHA256SUMS and listed in its FETCH manifest. 11.7 MB
# that never changes without a version bump does not belong in every clone.
web/vendor/face-detection/*.binarypb
web/vendor/face-detection/*.tflite
web/vendor/face-detection/*.wasm
# Same rule for the avatar model, pinned in web/vendor/avatar/SHA256SUMS: 10.4 MB
# of art asset with an upstream URL, listed in web/vendor/avatar/FETCH. Its
# sibling three-vrm.js is built locally, not fetched, so it stays committed.
web/vendor/avatar/jim.vrm
# Same rule for Pyodide, pinned in web/vendor/pyodide/SHA256SUMS: 13.7 MB of
# interpreter, glue and stdlib, none of which changes without a version bump.
web/vendor/pyodide/*.js
web/vendor/pyodide/*.wasm
web/vendor/pyodide/*.zip
web/vendor/pyodide/*.json
# And the temp file a download in progress writes, which carries none of those
# suffixes: a run killed outright leaves one, and it is the same megabytes.
web/vendor/*/.*.part

# cargo-mutants scratch output; CI runs it on every pull request.
mutants.out/
