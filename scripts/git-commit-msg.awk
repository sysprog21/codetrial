# The text rules of scripts/git-commit-msg.sh, in one pass over a message that
# has already lost its comments and its scissors section. POSIX awk only: no
# regular expression intervals (mawk before 1.3.4 has none), no length() of an
# array, no gensub.
#
# Every complaint is a line on standard output, which the caller sends to
# standard error. The exit status is 16 plus the verdict, which that script
# documents and takes the 16 off; it is what tells a verdict from awk failing to
# run, which exits 2 on a program it cannot parse.

function complain(text)
{
    print "Commit message: " text
    rules++
}

function nonblank(s)
{
    return s ~ /[^ \t]/
}

# The address agents commit with, and the names of the tools, as pieces of the
# patterns below. Strings rather than regex literals so that each is written once.
BEGIN {
    agent_addr = "(noreply@anthropic\\.com|noreply@openai\\.com|codex@openai\\.com|noreply@aider\\.chat|amp@ampcode\\.com|cursoragent@cursor\\.com|([0-9]+\\+)?(copilot(\\[bot\\])?|(copilot-swe-agent|devin-ai-integration|claude|cursor|codex|gemini-code-assist|openhands-agent|google-labs-jules)\\[bot\\])@users\\.noreply\\.github\\.com|copilot@github\\.com)"
    # The tools, named once. A name on its own, or with product words after it,
    # is a tool's; "Claude Shannon" is a person and stays one.
    tools = "(claude|chatgpt|codex|copilot|github copilot|cursor( agent)?|gemini|gpt-[a-z0-9.]*|devin|aider|amp|jules|openhands|windsurf)"
    generic = "(an? ai|ai|an? llm|llm)"
    product = "(code|cli|agent|bot|opus|sonnet|haiku|pro|flash|[0-9][0-9a-z.-]*)"
    named = "(" tools "|" generic ")([ \t]+" product ")*([ \t]*\\([^)]*\\))?"
    # Where each tool is made, for a credit that names the tool and gives an
    # address: a person who shares the name has an address of their own.
    vendor = "(anthropic\\.com|openai\\.com|aider\\.chat|ampcode\\.com|cursor\\.(com|sh)|devin\\.ai|google\\.com|github\\.com|openhands\\.dev)"
    credit_keys = "^[ \t]*(co-authored-by|co-developed-by|signed-off-by|reviewed-by|suggested-by|reported-by|tested-by|acked-by)[ \t]*:[ \t]*"
    # Devin and Jules are also first names, so a name decides nothing by itself
    # beside an address: it counts alone or at the tool's own domain.
    credit_trailer = credit_keys "(" named "[ \t]*(<[^>]*@" vendor ">)?[ \t]*$|.*<" agent_addr ">)"
    # Assisted-by and Generated-by are tool trailers in their own right, in the
    # kernel's "AGENT:MODEL" shape or with any address after the name;
    # "Assisted-by: Ada" and "Assisted-by: Claude Shannon" credit a person.
    tool_trailer = "^[ \t]*(assisted-by|generated-by)[ \t]*:[ \t]*(\\[?" named "(:[^ \t]*)?[ \t]*(<[^>]*>)?[ \t]*$|.*<" agent_addr ">)"
    extension = "(^|/)[a-z0-9_-][a-z0-9_.+-]*\\.(js|mjs|cjs|jsx|ts|tsx|json|jsonc|yml|yaml|toml|lock|md|txt|sh|bash|py|rs|c|h|cc|cpp|hpp|go|java|kt|rb|php|html|css|scss|svg|png|jpg|gif|ico|awk|jq|sql|xml|csv|env|cfg|conf|ini|mk|lua|pl|swift)(:[0-9]+(-[0-9]+)?|#[a-z0-9_.-]+)?$"
    # A reference in the shapes the log and GitHub write, and the separators
    # between them.
    ref = "(([a-z0-9_.-]+/[a-z0-9_.-]+)?#[0-9]+|https?://[^ \t]+/(issues|pull)/[0-9]+(#[a-z0-9-]*)?)"
    reference_line = "^[ \t]*(refs?|references?)[ \t]*:?[ \t]*" ref "([ \t]*([,;][ \t]*(and|&)?|and|&)?[ \t]*" ref ")*[ \t]*[.]?$"
    # The footer an agent writes about itself, anchored to the start of a line
    # so prose such as "files generated by codex" stays prose, and ending where
    # the line ends or a product word follows, so "Created with cursor (0, 0)"
    # stays prose too.
    footer = "^[^a-z0-9]*(generated|created|written|authored|made|built|produced|assisted|drafted|co-authored)[ \t]+(with|by|using|via)[ \t]+\\[?(" tools "|" generic ")(\\]|[ \t]*[.!]?[ \t]*$|[ \t]+" product ")"
}

# An attribution names a tool, which tells a reader nothing about who to ask and
# is no more a collaborator than the editor was. Matched on the address agents
# commit with, never on a name, since a person may well be called Claude or work
# at the company that makes one. A line of lowercase text arrives here.
function attribution(line)
{
    return line ~ credit_trailer || line ~ tool_trailer || line ~ footer ||
        line ~ /^[ \t]*(ai-assisted-by|ai-generated-by)[ \t]*:/ ||
        line ~ /claude\.com\/claude-code|claude\.ai\/code|chatgpt\.com\/codex|cursor\.com\/agents/
}

# A reference that closes nothing and sits where the closing line goes reads as
# the closing line. The log says what it finishes with Close, and a reference
# belongs in the description, where it is read as context.
function reference(line)
{
    return line ~ reference_line
}

# What a token is once an opening bracket, a quote and trailing punctuation are
# set aside: they are not part of a link or a file name.
function core(word)
{
    sub(/^[][(<"'`]+/, "", word)
    sub(/[])>"'`.,;:!?]+$/, "", word)
    return word
}

# A link or a path or file name, which cannot be wrapped without breaking it. A
# line number or an anchor after a path belongs to it.
function unbreakable(word)
{
    if (word ~ /^[A-Za-z][A-Za-z0-9+.-]*:\/\/[^ \t]+$/ || word ~ /^www\.[^ \t]+$/)
        return 1
    if (word ~ /^[A-Za-z0-9_.~@+-]*(\/[A-Za-z0-9_.~@+-]+)+\/?(:[0-9]+(-[0-9]+)?|#[A-Za-z0-9_.-]+)?$/ ||
        word ~ /^[A-Za-z0-9_.~@+-]+\/$/)
        return 1
    return word ~ /^[A-Za-z0-9_-][A-Za-z0-9_.+-]*\.[A-Za-z][A-Za-z0-9]*(:[0-9]+(-[0-9]+)?|#[A-Za-z0-9_.-]+)?$/
}

# The width a line would have with each unbreakable token longer than a whole
# line cut down to one column. A token that fits on a line of its own is moved
# there by a wrap, so it earns no exemption, and a handful of short file names
# never add up to one. Only the overflow nothing can fix is forgiven; a long
# word that is not a link or a file name is prose and counts in full. The length
# that counts is the token's own, without the bracket or quote around it.
function width(line,    len, count, words, i, bare)
{
    len = length(line)
    count = split(line, words, " ")
    for (i = 1; i <= count; i++) {
        bare = core(words[i])
        if (length(bare) > 72 && unbreakable(bare))
            len -= length(words[i]) - 1
    }
    return len
}

# The first word of the subject completes "this commit will ...", so a past
# tense, a gerund or a third person is the whole tell. Named rather than matched
# by suffix, which would also refuse "Alias", "Seed" and "Bring".
function non_imperative(word)
{
    return index(" added adds adding adjusted adjusts adjusting allowed allows allowing avoided avoids avoiding bumped bumps bumping changed changes changing checked checks checking cleaned cleans cleaning corrected corrects correcting created creates creating deleted deletes deleting disabled disables disabling dropped drops dropping enabled enables enabling fixed fixes fixing handled handles handling implemented implements implementing improved improves improving included includes including introduced introduces introducing made makes making moved moves moving refactored refactors refactoring removed removes removing renamed renames renaming replaced replaces replacing reverted reverts reverting tested tests testing tidied tidies tidying updated updates updating used uses using wired wires wiring lets letting built builds building wrote writes writing ran runs running kept keeps keeping sent sends sending brought brings bringing took takes taking gave gives giving got gets getting began begins beginning chose chooses choosing met meets meeting held holds holding told tells telling thought thinks thinking ", " " word " ")
}

# File evidence, narrower than unbreakable(): slash notation such as CI/CD or
# input/output is prose, and so is a dotted API name such as Math.floor, so a
# path has to end in a known file extension or a slash, and a dotfile is its own
# name.
function file_named(t)
{
    return t ~ /^\.[a-z][a-z0-9._-]*$/ ||
        t ~ /^[A-Za-z0-9_.~@+-]+(\/[A-Za-z0-9_.~@+-]+)*\/$/ ||
        (unbreakable(t) && t !~ /:\/\// && t ~ extension)
}

# A generic verb and nothing but file names after it ("Update web/app.js") says
# where the change is and not what it does, which is all a log is for. A specific
# verb with a path ("Remove web/old.js", "Rename a.js to b.js") still says what
# happened, so only the verbs that say nothing count.
function names_only(subject,    words, count, i, t, named)
{
    count = split(tolower(subject), words, " ")
    if (index(" update change modify edit fix tweak adjust touch improve revise refactor clean cleanup rework rewrite patch amend correct ", " " words[1] " ") == 0)
        return 0
    for (i = 2; i <= count; i++) {
        t = core(words[i])
        if (t == "the" || t == "and" || t == "&" || t == ",")
            continue
        if (file_named(t) || index(" readme makefile license changelog contributing dockerfile ", " " t " "))
            named = 1
        else
            return 0
    }
    return named
}

function credits_tool(    i)
{
    for (i = 1; i <= count; i++)
        if (attribution(low[i]))
            return 1
    return 0
}

# The verdict: what is said about a credit to a tool, and the status that adds
# up the rest.
function finish()
{
    if (ai)
        print "Commit message: remove the AI attribution: it names a tool, and the log credits people"
    exit (16 + (rules ? 1 : 0) + (ai ? 2 : 0))
}

{
    line[++count] = $0
    low[count] = tolower($0)
}

END {
    subject = line[1]
    ai = credits_tool()

    # An autosquash marker is a note to a rebase that has not happened yet, and
    # the subject behind it is a copy of another commit's: the change belongs in
    # that commit before this one exists. A merge subject is git's wording, not
    # the author's, and judging it is judging a message nobody wrote.
    if (subject ~ /^(fixup|squash|amend)! /) {
        complain("fold this into the commit it fixes: git commit --amend for HEAD, git rebase -i --autosquash for an older one")
        finish()
    }
    if (subject ~ /^Merge (branch|branches|tag|commit|pull request|remote-tracking branch) /)
        finish()

    if (subject == "")
        complain("a descriptive subject is required")
    else if (length(subject) > 50)
        complain("subject is " length(subject) " characters; keep it within 50")
    else if (subject !~ /[ \t]/)
        complain("subject must say more than one word")

    # ASCII covers three rules at once: no tabs or control characters, no CJK,
    # and no em dash or typographic quote smuggled in by an editor that
    # autocorrects. The caller runs this in the C locale, so a byte is a column.
    for (i = 1; i <= count; i++)
        if (line[i] ~ /[^ -~]/) {
            complain("message must be printable ASCII")
            break
        }

    if (subject ~ /^[ \t]/)
        complain("subject must not start with whitespace")
    else if (subject ~ /^[a-z]/)
        complain("capitalize the subject")

    if (subject ~ /\.$/)
        complain("subject must not end with a period")

    word = tolower(subject)
    sub(/[ \t].*/, "", word)
    if (non_imperative(word))
        complain("use the imperative mood: \"" word "\" describes what you did")

    if (names_only(subject))
        complain("the subject only names a file. It says where the change is, not what it does, so the log and a later bisect tell a reader nothing. Say what behaves differently, e.g. \"Recheck setup after the capture picker closes\"")

    # This log has no conventional-commit prefixes and no backticks in a subject.
    # Both read as an import from another project's tooling.
    if (subject ~ /^[A-Za-z]+(\([^)]*\))?!?: /)
        complain("subject must not use conventional-commit syntax")
    if (index(subject, "`"))
        complain("subject must not contain backticks")

    # Line 2 is where the body starts, so a non-empty one is a body that began
    # without a blank line between it and the subject.
    if (line[2] != "")
        complain("separate the subject from the body with a blank line")

    # A subject names the change and cannot also carry the reason for it, which
    # is what a reviewer and a later bisect need.
    for (first = 2; first <= count && (!nonblank(line[first]) || low[first] ~ /^(change-id|rechained):/); first++)
        ;
    if (first > count)
        complain("a body is required: say what changed and why")

    # Wrapped at 72, except where the overflow is a link or a file name, and on
    # a trailer such as Co-authored-by, which git reads only as one line.
    for (i = 2; i <= count; i++)
        if (length(line[i]) > 72 && width(line[i]) > 72 &&
            line[i] !~ /^[A-Za-z][A-Za-z0-9]*(-[A-Za-z0-9]+)+:[ \t]/) {
            complain("wrap body lines at 72 characters; only a link or file name longer than a line may run past")
            break
        }

    # The reasoning per decision lives in the comment next to the code in this
    # tree. A body that walks through the implementation duplicates it and then
    # goes stale on its own.
    for (i = 2; i <= count; i++)
        if (low[i] ~ /^(how|implementation( (details|notes|steps))?|steps?|changes)[ \t]*:/) {
            complain("the body carries what and why; how is the diff's job")
            break
        }

    # Reading from the bottom, since the last line is the one that stands where
    # the closing reference goes.
    for (last = count; last > 0 && (!nonblank(line[last]) || low[last] ~ /^(change-id|rechained):/); last--)
        ;
    if (last > 1 && reference(low[last]))
        complain("end with Close #N when this finishes the issue, or move the reference into the description; an issue too large for one change is split into sub-issues")

    # Not an error: long bodies exist in this history. Still worth saying once,
    # because the house shape is a premise and its trade, not a retelling. A
    # paragraph break is a run of blank lines between two lines of text.
    for (i = first + 1; i <= last; i++)
        if (nonblank(line[i]) && !nonblank(line[i - 1]))
            gaps++
    if (gaps > 1)
        print "Commit message: note, " (gaps + 1) " paragraphs; one usually carries it."

    finish()
}
