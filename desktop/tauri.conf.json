{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeTrial",
  "mainBinaryName": "codetrial-desktop",
  "identifier": "org.sysprog21.codetrial",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "shortDescription": "Practice technical interviews with a real-time AI interviewer",
    "longDescription": "CodeTrial runs a timed coding interview with an AI interviewer that listens, speaks and reads your code as you write it.",
    "copyright": "Copyright (c) sysprog21",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
